  "rungs": {
    "a1": {
      "comment": "A1 — Atraso de partida: EMG_OK · STOP_OK · START habilita T1 (TON, PT = 3 s). Sem um permissivo ou sem START, T1 zera ET e Q.",
      "elements": [
        "a1_emg",
        "a1_stop",
        "a1_start",
        "a1_t1"
      ],
      "input": false,
      "out": false
    },
    "a2": {
      "comment": "A2 — MOTOR_DELAY = T1.Q: o motor liga quando ET alcança PT.",
      "elements": [
        "a2_q",
        "a2_motor"
      ],
      "input": false,
      "out": false
    },
    "a3": {
      "comment": "A3 — Fase apagada: HAB_PISCA · ¬PISCA cronometra T_DESL (PT = 1 s).",
      "elements": [
        "a3_hab",
        "a3_fase",
        "a3_t"
      ],
      "input": false,
      "out": false
    },
    "a4": {
      "comment": "A4 — Fase acesa: HAB_PISCA · PISCA cronometra T_LIG (PT = 1 s).",
      "elements": [
        "a4_hab",
        "a4_fase",
        "a4_t"
      ],
      "input": false,
      "out": false
    },
    "a5_liga": {
      "comment": "",
      "elements": [
        "a5_apagada",
        "a5_fim_desl"
      ],
      "input": false,
      "out": false
    },
    "a5_mantem": {
      "comment": "",
      "elements": [
        "a5_acesa",
        "a5_fim_lig"
      ],
      "input": false,
      "out": false
    },
    "a5": {
      "comment": "A5 — Próxima fase: PISCA = HAB_PISCA · (¬PISCA·T_DESL.Q + PISCA·¬T_LIG.Q). Só acende ao fim da fase apagada e só apaga ao fim da acesa; a troca desliga o temporizador que terminou.",
      "elements": [
        "a5_hab",
        "br_a5",
        "a5_pisca"
      ],
      "input": false,
      "out": false
    },
    "a6": {
      "comment": "A6 — LAMPADA segue a fase PISCA.",
      "elements": [
        "a6_pisca",
        "a6_lamp"
      ],
      "input": false,
      "out": false
    },
    "a7": {
      "comment": "A7 — Borda de subida: P_PECA = S_PECA · ¬S_PECA_ANT (calculada antes de atualizar a memória).",
      "elements": [
        "a7_s",
        "a7_ant",
        "a7_p"
      ],
      "input": false,
      "out": false
    },
    "a8": {
      "comment": "A8 — Memória do valor anterior: S_PECA = 1 grava S_PECA_ANT (SET).",
      "elements": [
        "a8_s",
        "a8_set"
      ],
      "input": false,
      "out": false
    },
    "a9": {
      "comment": "A9 — Memória do valor anterior: S_PECA = 0 apaga S_PECA_ANT (RESET).",
      "elements": [
        "a9_s",
        "a9_rst"
      ],
      "input": false,
      "out": false
    },
    "a10": {
      "comment": "A10 — Zeragem: RESET_LOTE escreve C_LOTE.R antes do contador — o reset domina uma contagem simultânea.",
      "elements": [
        "a10_rst",
        "a10_r"
      ],
      "input": false,
      "out": false
    },
    "a11": {
      "comment": "A11 — Contagem: cada pulso P_PECA incrementa C_LOTE (CTU, PV = 5).",
      "elements": [
        "a11_p",
        "a11_ctu"
      ],
      "input": false,
      "out": false
    },
    "a12": {
      "comment": "A12 — LOTE_OK = (C_LOTE.CV ≥ C_LOTE.PV): continua sinalizado se passar do lote.",
      "elements": [
        "a12_cmp",
        "a12_ok"
      ],
      "input": false,
      "out": false
    }
  },
