        <mxCell id="detect-demand" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Detectar aproximação&lt;br&gt;e ocupação" vertex="1">
