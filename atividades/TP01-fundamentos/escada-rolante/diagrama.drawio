        <mxCell id="monitor-safety" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Monitorar dispositivos&lt;br&gt;de segurança&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;pente · entrada · circuito&lt;/font&gt;" vertex="1">
