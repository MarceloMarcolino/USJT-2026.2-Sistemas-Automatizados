        <mxCell id="logic" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#173B5C;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=18;shadow=0;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Avaliar demanda e transporte&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;R1 · INICIAR&lt;/b&gt;&lt;br&gt;Habilitada + aproximação + zona/dispositivos livres&lt;br&gt;+ sem falha/emergência → liberar freio e acelerar até nominal.&lt;br&gt;&lt;br&gt;&lt;b&gt;R2 · TRANSPORTAR&lt;/b&gt;&lt;br&gt;Com ocupação/demanda + velocidades coerentes → manter nominal.&lt;br&gt;&lt;br&gt;&lt;b&gt;R3 · ESPERA ECONÔMICA&lt;/b&gt;&lt;br&gt;Sem presença + zona livre por T_espera → desacelerar, parar e frear.&lt;br&gt;&lt;br&gt;&lt;b&gt;R0 · DESABILITADA/MANUTENÇÃO&lt;/b&gt;&lt;br&gt;Bloquear acionamento + aplicar freio; não avaliar R1–R3.&lt;br&gt;&lt;br&gt;Fora das permissivas → rejeitar partida.&lt;br&gt;&lt;i&gt;T_espera configurável · referência: 30 s&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="340" width="400" x="480" y="130" as="geometry" />
        </mxCell>
        <mxCell id="signal" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#6B4F7A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#2F2436;spacing=10;shadow=0;" value="Sinalizar estado&lt;br&gt;e falhas" vertex="1">
          <mxGeometry height="85" width="220" x="960" y="130" as="geometry" />
        </mxCell>
        <mxCell id="drive" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A5B13;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#3D2A0D;spacing=10;shadow=0;" value="Comandar acionamento&lt;br&gt;e freio&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;inversor · motor · freio&lt;/font&gt;" vertex="1">
