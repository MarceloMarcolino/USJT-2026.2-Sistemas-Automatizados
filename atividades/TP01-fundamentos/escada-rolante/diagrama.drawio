          <mxGeometry height="90" width="190" x="1240" y="270" as="geometry" />
        </mxCell>
        <mxCell id="measure-speed" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Medir velocidades&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;degraus · corrimão&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="190" x="1240" y="505" as="geometry" />
        </mxCell>

        <mxCell id="safe-state" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#3C7A47;strokeWidth=1.5;dashed=1;dashPattern=4 3;fontFamily=Helvetica;fontSize=12;fontColor=#174A24;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;ESTADO SEGURO / REARME&lt;/b&gt;&lt;br&gt;Acionamento sem energia; degraus e corrimão parados; freio aplicado.&lt;br&gt;Após R4/R5: eliminar a causa, inspecionar e executar rearme manual autorizado; sem reinício automático.&lt;br&gt;Falta de energia: freio fail-safe aplicado mecanicamente, fora da lógica." vertex="1">
          <mxGeometry height="170" width="420" x="60" y="560" as="geometry" />
        </mxCell>
        <mxCell id="fault-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF4C2;strokeColor=#8A6A00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#4A3400;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;R4 · PROTEÇÃO / EMERGÊNCIA&lt;/b&gt;&lt;br&gt;Pente/entrada atuado, objeto preso ou emergência → retirar comando, parada de segurança, freio + alarme.&lt;br&gt;&lt;br&gt;&lt;b&gt;R5 · FALHA DE MOVIMENTO&lt;/b&gt;&lt;br&gt;Sem velocidade após comando, sobrevelocidade ou diferença anormal degraus–corrimão → retirar comando, freio + alarme.&lt;br&gt;&lt;b&gt;R4/R5 prevalecem sobre R1–R3; bloqueio retido até inspeção e rearme manual.&lt;/b&gt;" vertex="1">
          <mxGeometry height="190" width="420" x="500" y="560" as="geometry" />
        </mxCell>
        <mxCell id="predictive" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0E7490;strokeWidth=1.5;dashed=1;dashPattern=4 3;fontFamily=Helvetica;fontSize=12;fontColor=#164E63;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;MELHORIA POSSÍVEL · MANUTENÇÃO PREDITIVA&lt;/b&gt;&lt;br&gt;Tendências de vibração do mecanismo + corrente do motor durante partidas/operação → antecipar desgaste, desalinhamento ou esforço crescente e programar manutenção antes da parada. Melhora disponibilidade; não substitui intertravamentos nem altera o estado seguro." vertex="1">
          <mxGeometry height="105" width="860" x="60" y="780" as="geometry" />
        </mxCell>

        <mxCell id="legend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;LEGENDA VISUAL&lt;/b&gt;&lt;br&gt;&lt;b&gt;Linhas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;━━&lt;/font&gt; fluxo/sinal&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B45309&quot;&gt;━━&lt;/font&gt; ação física&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#0072B2&quot;&gt;━·━&lt;/font&gt; intertravamento&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#00866A&quot;&gt;━━━&lt;/font&gt; realimentação&lt;br&gt;&lt;font color=&quot;#A23B72&quot;&gt;┄┄&lt;/font&gt; perturbação externa&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#64748B&quot;&gt;···&lt;/font&gt; vínculo/anotação&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#C62828&quot;&gt;━━━&lt;/font&gt; emergência&lt;br&gt;&lt;b&gt;Blocos funcionais&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5D8A&quot;&gt;■&lt;/font&gt; sensoriamento/medição&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1F4E79&quot;&gt;■&lt;/font&gt; controle/lógica&lt;br&gt;&lt;font color=&quot;#9A5B13&quot;&gt;■&lt;/font&gt; atuação/mecanismo&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#6B4F7A&quot;&gt;■&lt;/font&gt; sinalização/diagnóstico" vertex="1">
          <mxGeometry height="150" width="460" x="950" y="650" as="geometry" />
        </mxCell>
