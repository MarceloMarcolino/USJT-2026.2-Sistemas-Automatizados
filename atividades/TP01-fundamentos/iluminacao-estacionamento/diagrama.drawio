        <mxCell id="logic" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#173B5C;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=18;shadow=0;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Avaliar acionamento&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;lógica booleana e temporização&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;DemandaAuto&lt;/b&gt; = LuzBaixa &lt;b&gt;E&lt;/b&gt; (Presença &lt;b&gt;OU&lt;/b&gt; HorárioDeMovimento)&lt;br&gt;&lt;br&gt;&lt;b&gt;R1 · AUTO / ACENDER&lt;/b&gt;&lt;br&gt;Modo automático E DemandaAuto → LIGAR.&lt;br&gt;&lt;br&gt;&lt;b&gt;R2 · AUTO / APAGAR&lt;/b&gt;&lt;br&gt;Modo automático E NÃO DemandaAuto continuamente por T_des → DESLIGAR.&lt;br&gt;Nova demanda cancela a temporização. T_des configurável; referência: 10 min.&lt;br&gt;&lt;br&gt;&lt;b&gt;R3 · MANUAL&lt;/b&gt;&lt;br&gt;Seguir e registrar LIGAR/DESLIGAR, salvo bloqueio seguro da R4.&lt;br&gt;&lt;br&gt;&lt;b&gt;PRIORIDADE&lt;/b&gt;&lt;br&gt;R4 fallback noturno &amp;gt; R3 manual &amp;gt; R1/R2 automático.&lt;br&gt;&lt;br&gt;Comando diferente do retorno elétrico → manter o comando seguro e diagnosticar.&lt;/font&gt;" vertex="1">
          <mxGeometry x="740" y="220" width="460" height="460" as="geometry" />
        </mxCell>

