        <mxCell id="fault-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF4C2;strokeColor=#8A6A00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#4A3400;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;R4 · FALHA DO SENSOR DE PRESENÇA&lt;/b&gt;&lt;br&gt;Detecção contínua &amp;gt; 60 min → suspeita de travamento em detectado.&lt;br&gt;Noturno: manter acesa + diagnóstico.&lt;br&gt;Diurno: R2 pode apagar após T_des.&lt;br&gt;Travado em livre não é comprovável neste modelo: janela de horário, manual e manutenção mitigam." vertex="1">
