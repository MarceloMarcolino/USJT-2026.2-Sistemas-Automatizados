        </mxCell>

        <mxCell id="sensor" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Medir nível (sensor)" vertex="1">
          <mxGeometry height="90" width="220" x="70" y="240" as="geometry" />
        </mxCell>
        <mxCell id="controller" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#173B5C;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=16;shadow=0;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Decidir liga/desliga (controlador)&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CONDIÇÃO DESEJADA (SETPOINT)&lt;/b&gt; — nível na faixa operacional&lt;br&gt;L_baixo/L_alto: limites com histerese, não dois setpoints&lt;br&gt;Ordem crescente: L_baixo → L_alto → LAA; valores simbólicos&lt;br&gt;&lt;b&gt;PREMISSA DIAGNÓSTICA&lt;/b&gt; — vazão da bomba &gt; consumo máximo admissível&lt;br&gt;&lt;br&gt;&lt;b&gt;PRIORIDADE: R0 primeiro; depois R5, R4 e R1–R3&lt;/b&gt;&lt;br&gt;&lt;b&gt;R0 · REPOUSO (SEM LATCH)&lt;/b&gt; — desabilitado → desligar; reabilitação permitida sem falha retida&lt;br&gt;&lt;b&gt;R1 · REPOR&lt;/b&gt; — nível ≤ L_baixo ∧ sem falha → ligar bomba&lt;br&gt;&lt;b&gt;R2 · LIMITAR&lt;/b&gt; — nível ≥ L_alto → desligar bomba&lt;br&gt;&lt;b&gt;R3 · HISTERESE&lt;/b&gt; — entre os limites → manter estado&lt;br&gt;&lt;b&gt;R4 · ALTO-ALTO&lt;/b&gt; — nível ≥ LAA → desligar + alarmar + latch/rearme&lt;br&gt;&lt;b&gt;R5 · SENSOR/RESPOSTA INCOERENTE&lt;/b&gt; — sinal fora da faixa OU, após LIGAR, sem tendência de subida por T_diag → suspeita; desligar + alarmar + latch/rearme&lt;br&gt;&lt;b&gt;Fora das permissivas → rejeitar ligação&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="385" width="470" x="420" y="125" as="geometry" />
        </mxCell>
        <mxCell id="signal" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#6B4F7A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#2F2436;spacing=10;shadow=0;" value="Sinalizar e alarmar" vertex="1">
          <mxGeometry height="75" width="230" x="1120" y="125" as="geometry" />
        </mxCell>
        <mxCell id="pump" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A5B13;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#3D2A0D;spacing=10;shadow=0;" value="Acionar bomba" vertex="1">
          <mxGeometry height="90" width="190" x="1100" y="260" as="geometry" />
        </mxCell>
        <mxCell id="plant" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A5B13;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#3D2A0D;spacing=10;shadow=0;" value="Reservatório e tubulações (planta)" vertex="1">
          <mxGeometry height="140" width="190" x="1470" y="230" as="geometry" />
        </mxCell>
        <mxCell id="fault-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF4C2;strokeColor=#8A6A00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#4A3400;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;R4/R5 · FALHA RETIDA (LATCH)&lt;/b&gt;&lt;br&gt;R4: alto-alto. R5: sinal fora da faixa OU, após LIGAR, sem tendência de subida por T_diag (vazão da bomba &gt; consumo máximo admissível) → suspeita de resposta incoerente.&lt;br&gt;Não há identificação causal: sensor travado, bomba sem resposta ou consumo fora da faixa recebem desligamento + alarme + latch/rearme." vertex="1">
          <mxGeometry height="130" width="600" x="450" y="570" as="geometry" />
        </mxCell>
        <mxCell id="safe-state" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#3C7A47;strokeWidth=1.5;dashed=1;dashPattern=4 3;fontFamily=Helvetica;fontSize=10.5;fontColor=#174A24;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;BOMBA DESLIGADA — RECUPERAÇÕES DISTINTAS&lt;/b&gt;&lt;br&gt;&lt;b&gt;R0 · repouso sem latch:&lt;/b&gt; reabilitar permite nova avaliação se não houver falha retida.&lt;br&gt;&lt;b&gt;R4/R5 · estado seguro:&lt;/b&gt; sem retomada automática; inspecionar e rearmar.&lt;br&gt;Sem energia, a bomba para passivamente. Manutenção somente desabilitada." vertex="1">
          <mxGeometry height="130" width="360" x="60" y="570" as="geometry" />
        </mxCell>
        <mxCell id="disturbance" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#A23B72;strokeWidth=1.5;dashed=1;dashPattern=8 5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#7A2955;align=center;verticalAlign=middle;spacing=8;shadow=0;" value="Perturbação: consumo variável (ambiente)" vertex="1">
          <mxGeometry height="50" width="300" x="1740" y="450" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;LEGENDA VISUAL · redundante em escala de cinza&lt;/b&gt;&lt;br&gt;&lt;b&gt;Linhas e pontas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;──▷&lt;/font&gt; fluxo/sinal: fina + ponta aberta&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B45309&quot;&gt;━━▶&lt;/font&gt; ação física: grossa + ponta cheia&lt;br&gt;&lt;font color=&quot;#00866A&quot;&gt;━━▶&lt;/font&gt; realimentação: grossa + rótulo&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#A23B72&quot;&gt;┄┄▷&lt;/font&gt; perturbação externa&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;···&lt;/font&gt; vínculo de regra: pontilhado, sem ponta&lt;br&gt;&lt;b&gt;Blocos funcionais&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5D8A&quot;&gt;■&lt;/font&gt; medição&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1F4E79&quot;&gt;■&lt;/font&gt; controle/lógica&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#9A5B13&quot;&gt;■&lt;/font&gt; atuação/planta&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#6B4F7A&quot;&gt;■&lt;/font&gt; sinalização" vertex="1">
          <mxGeometry height="150" width="500" x="1130" y="550" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
