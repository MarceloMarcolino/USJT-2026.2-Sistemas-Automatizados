  <diagram name="Página-1" id="reservatorio-controle-nivel">
    <mxGraphModel dx="1900" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="950" math="0" shadow="0">
