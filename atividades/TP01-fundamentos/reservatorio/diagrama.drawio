        <mxCell id="boundary" parent="1" style="swimlane;horizontal=1;startSize=75;rounded=1;arcSize=8;html=1;fillColor=#E2E8F0;swimlaneFillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=16;collapsible=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;b&gt;Sistema: controle de nível do reservatório&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Objetivo: manter o nível na faixa operacional, repor o consumo e evitar transbordamento.&lt;/font&gt;" vertex="1">
