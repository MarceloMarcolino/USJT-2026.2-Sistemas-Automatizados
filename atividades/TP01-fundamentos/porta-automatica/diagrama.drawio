        <mxCell id="iqZHQVuNfYHGagjMLtmr-1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Detectar presença" vertex="1">
          <mxGeometry height="80" width="210" x="60" y="120" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Monitorar barreira do vão" vertex="1">
          <mxGeometry height="90" width="210" x="60" y="290" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#173B5C;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=18;shadow=0;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Avaliar abertura e fechamento&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;R1 · ABRIR&lt;/b&gt;&lt;br&gt;Se habilitado, com presença, porta não aberta,&lt;br&gt;sem falha e fora de emergência → abrir.&lt;br&gt;&lt;br&gt;&lt;b&gt;R2 · FECHAR&lt;/b&gt;&lt;br&gt;Se habilitado, com porta aberta, sem presença,&lt;br&gt;vão livre por T, sem falha e fora de emergência → fechar.&lt;br&gt;&lt;br&gt;&lt;b&gt;R3 · PROTEGER&lt;/b&gt;&lt;br&gt;Se o feixe for interrompido durante o fechamento → parar e reabrir.&lt;br&gt;&lt;br&gt;Fora das permissivas normais de R1/R2 → rejeitar comando.&lt;br&gt;&lt;i&gt;T configurável · referência: 3 s&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="280" width="360" x="470" y="120" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-7" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#6B4F7A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#2F2436;spacing=10;shadow=0;" value="Sinalizar estado e falhas" vertex="1">
          <mxGeometry height="80" width="190" x="930" y="120" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-5" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A5B13;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#3D2A0D;spacing=10;shadow=0;" value="Comandar motor" vertex="1">
          <mxGeometry height="80" width="190" x="930" y="230" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-6" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#9A5B13;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#3D2A0D;spacing=10;shadow=0;" value="Mover porta (motor/mecanismo)" vertex="1">
          <mxGeometry height="80" width="180" x="1200" y="230" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2C5D8A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2937;spacing=10;shadow=0;" value="Medir posição da porta" vertex="1">
          <mxGeometry height="80" width="180" x="1200" y="460" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-35" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF4C2;strokeColor=#8A6A00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#4A3400;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;R4 · FALHA ATIVA&lt;/b&gt;&lt;br&gt;Posição aberta + fechada simultaneamente OU ausência de transição após comando (sensor ou acionamento) → parar comandos, impedir fechamento automático e alarmar." vertex="1">
          <mxGeometry height="120" width="360" x="470" y="485" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-37" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#3C7A47;strokeWidth=1.5;dashed=1;dashPattern=4 3;fontFamily=Helvetica;fontSize=12;fontColor=#174A24;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;R5 · ESTADO SEGURO — prevalece sobre R1–R4&lt;/b&gt;&lt;br&gt;Emergência → abrir e manter aberta.&lt;br&gt;Após falha ou emergência: sem retomada automática; retorno somente por rearme manual na habilitação.&lt;br&gt;Fallback mecânico, fora da lógica: motor sem resposta ou falta de energia → desacoplamento fail-safe e abertura manual." vertex="1">
          <mxGeometry height="150" width="400" x="60" y="485" as="geometry" />
        </mxCell>
        <mxCell id="iqZHQVuNfYHGagjMLtmr-39" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#A23B72;strokeWidth=1.5;dashed=1;dashPattern=8 5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#7A2955;align=center;verticalAlign=middle;spacing=8;shadow=0;" value="Perturbação: obstáculo / fluxo de pessoas (ambiente)" vertex="1">
          <mxGeometry height="40" width="400" x="600" y="735" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacing=12;shadow=0;" value="&lt;b&gt;LEGENDA VISUAL&lt;/b&gt;&lt;br&gt;&lt;b&gt;Linhas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;━━&lt;/font&gt; fluxo/sinal&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B45309&quot;&gt;━━&lt;/font&gt; ação física&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#0072B2&quot;&gt;━·━&lt;/font&gt; intertravamento&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#00866A&quot;&gt;━━━&lt;/font&gt; realimentação&lt;br&gt;&lt;font color=&quot;#A23B72&quot;&gt;┄┄&lt;/font&gt; perturbação externa&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#64748B&quot;&gt;···&lt;/font&gt; vínculo de regra&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#C62828&quot;&gt;━━━&lt;/font&gt; emergência&lt;br&gt;&lt;b&gt;Blocos funcionais&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5D8A&quot;&gt;■&lt;/font&gt; sensoriamento/medição&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1F4E79&quot;&gt;■&lt;/font&gt; controle/lógica&lt;br&gt;&lt;font color=&quot;#9A5B13&quot;&gt;■&lt;/font&gt; atuação/mecanismo&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#6B4F7A&quot;&gt;■&lt;/font&gt; sinalização/diagnóstico" vertex="1">
