        <object label="&lt;font color=&quot;#111827&quot;&gt;&lt;b&gt;Entradas e saídas&lt;/b&gt;&lt;/font&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; cellspacing=&quot;0&quot; width=&quot;100%&quot; style=&quot;border-collapse:collapse;font-size:10px;color:#111827;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th align='left'&gt;Tag&lt;/th&gt;&lt;th align='left'&gt;Tipo&lt;/th&gt;&lt;th align='left'&gt;Significado&lt;/th&gt;&lt;th&gt;Seg.&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;S_PECA&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;peça na estação de leitura&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;TIPO_A&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;sensor classifica como A&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;TIPO_B&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;sensor classifica como B&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FC_AV_A / FC_RET_A&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;desviador A avançado / recolhido&lt;/td&gt;&lt;td align='center'&gt;0 / 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;FC_AV_B / FC_RET_B&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;desviador B avançado / recolhido&lt;/td&gt;&lt;td align='center'&gt;0 / 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RESET&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E&lt;/td&gt;&lt;td&gt;rearme após falha&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;M_EST&lt;/b&gt;&lt;/td&gt;&lt;td&gt;S&lt;/td&gt;&lt;td&gt;motor da esteira&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Y_A&lt;/b&gt;&lt;/td&gt;&lt;td&gt;S&lt;/td&gt;&lt;td&gt;solenoide do desviador A&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Y_B&lt;/b&gt;&lt;/td&gt;&lt;td&gt;S&lt;/td&gt;&lt;td&gt;solenoide do desviador B&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ALARME&lt;/b&gt;&lt;/td&gt;&lt;td&gt;S&lt;/td&gt;&lt;td&gt;alarme de falha&lt;/td&gt;&lt;td align='center'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" grafcet="rotulo" papel="tabela-es" id="tabela-es">
          <mxCell style="text;html=1;fontFamily=Helvetica;fontColor=#6B7280;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
            <mxGeometry x="830" y="420" width="280" height="230" as="geometry" />
          </mxCell>
        </object>
        <object label='&lt;font color="#111827"&gt;&lt;b&gt;Temporizações e notação&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;0,5 s/X1&lt;/b&gt; — estabilização da leitura; &lt;b&gt;2 s/X1&lt;/b&gt; — tempo máximo sem classificação (hipótese); &lt;b&gt;0,3 s/X4&lt;/b&gt; — confirmação do desvio. &lt;b&gt;T8&lt;/b&gt; (FC_RET_A ∧ FC_RET_B) — retorno confirmado antes de liberar: a esteira só religa em E6, com os dois desviadores recolhidos.' grafcet="rotulo" papel="legenda-tempos" id="legenda-tempos">
          <mxCell style="text;html=1;fontFamily=Helvetica;fontColor=#6B7280;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
            <mxGeometry x="830" y="660" width="280" height="80" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="A27 Percurso manual" id="pg-A27">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object label='&lt;font color="#111827" style="font-size:18px"&gt;&lt;b&gt;TP05 · Atividade 27 — Percurso manual (semáforo da página 2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Marcação inicial E0; a cada passo, a receptividade temporizada verdadeira dispara a transição e a marcação avança. Abaixo, percursos de fronteira (semáforo) e de falha (misturador, página 1) no mesmo formato. Página 5/5.&lt;/font&gt;' grafcet="rotulo" papel="titulo" id="titulo">
